{
    "extends": "expo/tsconfig.base",
    "compilerOptions": {
        "strict": true,
        "resolveJsonModule": true,
        "types": ["jest"],
        "paths": {
            "@/*": ["./*"]
        }
    },
    "include": [
        "**/*.ts",
        "**/*.tsx",
        "nativewind-env.d.ts",
        "css-modules.d.ts",
        "geojson-modules.d.ts",
        "babel.config.js",
        "tailwind.config.js",
        ".expo/types/**/*.ts",
        "expo-env.d.ts"
    ]
}
