{
  "name": "drone-weather",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest --watchAll",
    "test:ci": "jest --ci --coverage=false",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint -- --max-warnings=0",
    "build:android": "eas build --platform android --profile preview",
    "perf:android-audit": "powershell -ExecutionPolicy Bypass -File ./scripts/android-perf-audit.ps1",
    "format": "prettier --write ."
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    }
  },
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/outfit": "^0.4.3",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.2.0",
    "axios": "^1.18.1",
    "babel-preset-expo": "~57.0.0",
    "expo": "^57.0.0",
    "expo-constants": "~57.0.6",
    "expo-dev-client": "~57.0.7",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.3",
    "expo-location": "~57.0.5",
    "expo-router": "~57.0.7",
    "expo-splash-screen": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "expo-web-browser": "~57.0.1",
    "nativewind": "^4.2.6",
    "opencage-api-client": "^1.2.0",
    "openmeteo": "^1.2.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.0",
    "react-native-worklets": "0.10.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.1",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@react-native/jest-preset": "^0.86.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.10",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.2",
    "prettier": "^3.9.5",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "private": true
}
